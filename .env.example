# ==============================================================================
# FoodTour Environment Variables Template
# ==============================================================================

# Supabase Project Configuration (PostgreSQL + PostGIS RPC)
# Lấy từ Project Settings > API trên Supabase Dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key (Chỉ dùng cho scripts crawler & merge affiliate ở backend/local)
# CẢNH BÁO: Không bao giờ public key này lên frontend hoặc commit vào git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tuỳ chọn: Link ShopeeFood Affiliate đơn lẻ cho món cụ thể
VITE_SHOPEEFOOD_AFFILIATE_URL=
VITE_SHOPEEFOOD_AFFILIATE_RESTAURANT=
VITE_SHOPEEFOOD_AFFILIATE_DISHES=[]

# ==============================================================================
# FoodTour Environment Variables Template
# ==============================================================================

# Supabase Project Configuration (PostgreSQL + PostGIS RPC)
# Lấy từ Project Settings > API Keys > Publishable key trên Supabase Dashboard.
# Hai biến VITE_* này được đóng gói công khai. Không bao giờ dùng secret/service_role.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_with_your_public_key

# Chỉ cho máy vận hành crawler/import. Frontend và Vercel không cần các biến này.
# Không đặt tiền tố VITE_, không commit hoặc gửi khóa trong chat/log.
SUPABASE_SECRET_KEY=
# Tương thích khóa service_role cũ chưa thu hồi; ưu tiên SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Tuỳ chọn: Link ShopeeFood Affiliate đơn lẻ cho món cụ thể
VITE_SHOPEEFOOD_AFFILIATE_URL=
VITE_SHOPEEFOOD_AFFILIATE_RESTAURANT=
VITE_SHOPEEFOOD_AFFILIATE_DISHES=[]

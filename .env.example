# Optional public ShopeeFood link. Keep the exact URL issued by the program.
# Empty values keep the normal ShopeeFood search flow available.
# All VITE_ values are public in the browser. Do not put API secrets here.
VITE_SHOPEEFOOD_AFFILIATE_URL=
VITE_SHOPEEFOOD_AFFILIATE_RESTAURANT=
# JSON array of dish names verified by the restaurant / affiliate operator.
# For example: '["Bún đậu mắm tôm","Bún chả"]'
VITE_SHOPEEFOOD_AFFILIATE_DISHES=[]
